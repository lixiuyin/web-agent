{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lixiuyin/web-agent/main/src/webagent/schemas/study-manifest-v1.schema.json",
  "title": "web-agent study manifest v1",
  "description": "Immutable preregistration metadata for a reproducible comparative web-agent study. This schema records planned conditions and does not contain experimental results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "study_id",
    "title",
    "research_questions",
    "hypotheses",
    "suite",
    "task_manifest_sha256",
    "task_split_counts",
    "models",
    "conditions",
    "collection_dates",
    "repetitions",
    "budgets",
    "primary_metrics",
    "secondary_metrics",
    "failure_taxonomy_version",
    "confidence_target",
    "source_sha256",
    "created_at",
    "preregistration_sha256"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/lixiuyin/web-agent/main/src/webagent/schemas/study-manifest-v1.schema.json"
    },
    "schema_version": {"const": 1},
    "kind": {"const": "webagent-study"},
    "study_id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "research_questions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "hypotheses": {
      "type": "array",
      "items": {"type": "string"}
    },
    "suite": {"type": "string", "minLength": 1},
    "task_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "task_split_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "development": {"type": "integer", "minimum": 0},
        "validation": {"type": "integer", "minimum": 0},
        "held_out_task": {"type": "integer", "minimum": 0},
        "held_out_setting": {"type": "integer", "minimum": 0}
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model"}
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/condition"}
    },
    "collection_dates": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "format": "date"}
    },
    "repetitions": {"type": "integer", "minimum": 1},
    "budgets": {"$ref": "#/$defs/budgets"},
    "primary_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "secondary_metrics": {
      "type": "array",
      "items": {"type": "string"}
    },
    "failure_taxonomy_version": {"type": "string", "minLength": 1},
    "confidence_target": {
      "enum": ["task_success", "not_collected"]
    },
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "preregistration_sha256": {
      "anyOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "api_protocol", "vision_expected"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "api_protocol": {
          "enum": ["openai-compatible", "local-vllm"]
        },
        "vision_expected": {
          "type": ["boolean", "null"]
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "config_overrides"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": ["baseline", "intervention", "ablation"]
        },
        "description": {"type": "string", "minLength": 1},
        "config_overrides": {
          "type": "object"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_steps",
        "task_timeout_seconds",
        "tool_timeout_seconds",
        "planner_max_tokens"
      ],
      "properties": {
        "max_steps": {"type": "integer", "minimum": 1},
        "task_timeout_seconds": {"type": "integer", "minimum": 1},
        "tool_timeout_seconds": {"type": "integer", "minimum": 1},
        "planner_max_tokens": {"type": "integer", "minimum": 1}
      }
    }
  }
}
