digraph WebAgentArchitecture {
  graph [
    bgcolor="white",
    rankdir=TB,
    splines=polyline,
    pad=0.30,
    nodesep=0.44,
    ranksep=0.42,
    fontname="Arial",
    fontsize=20,
    labelloc="t",
    label="WebAgent: governed browser execution with auditable evidence"
  ];
  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#F8FAFC",
    color="#155E75",
    fontcolor="#102A43",
    fontname="Arial",
    fontsize=10.5,
    penwidth=1.4,
    margin="0.17,0.10"
  ];
  edge [
    color="#2563A6",
    fontcolor="#334E68",
    fontname="Arial",
    fontsize=8.5,
    penwidth=1.25,
    arrowsize=0.72
  ];

  task [label="Natural-language task", shape=oval, fillcolor="#E0F2FE"];
  entry [label="CLI / benchmark adapter"];
  config [
    label="AgentConfig\nvalidated provider, browser, policy, and discovery settings",
    fillcolor="#ECFDF5",
    color="#15803D"
  ];
  agent [
    label="WEBAGENT ORCHESTRATOR\nbounded Observe -> Think -> Act -> Record loop\nloop/strategy state + explicit CAPTCHA handling",
    fillcolor="#CCFBF1",
    color="#0F766E",
    penwidth=2.0,
    fontsize=11.5
  ];
  task -> entry -> config -> agent;

  browser [
    label="PLAYWRIGHT CHROMIUM\npage lifecycle + browser actions",
    fillcolor="#E0F2FE"
  ];
  observe [
    label="OBSERVE STABLE PAGE\nviewport PNG + rendered viewport/document projection\nobservation-bound control references",
    fillcolor="#E0F2FE"
  ];
  state [label="BrowserState\nscoped context + refs + metadata", fillcolor="#E0F2FE"];
  {rank=same; browser; observe;}
  browser -> observe [label="page"];
  agent -> observe;
  observe -> state;

  registry [label="TOOL REGISTRY\n67 auto-discovered ToolSpecs"];
  exposure [
    label="EXPOSURE FILTER\ndiscovery mode -> one allowed set",
    fillcolor="#FFF7ED",
    color="#D97706"
  ];
  planner [
    label="PLANNER\nAPIPlanner or StubPlanner\nhistory + controller hints + exposed schemas\nnative tools -> JSON Schema -> prompt JSON",
    fillcolor="#EEF2FF",
    color="#4F46E5"
  ];
  call [label="validated ToolCall", fillcolor="#EEF2FF", color="#4F46E5"];
  {rank=same; registry; exposure; planner;}
  registry -> exposure [label="ToolSpecs"];
  state -> planner [label="plan one action"];
  exposure -> planner [label="exposed schemas", color="#D97706", fontcolor="#B45309"];
  planner -> call [color="#4F46E5"];

  policies [
    label="RUNTIME POLICIES\nevidence policy + action-risk policy",
    fillcolor="#FFF7ED",
    color="#D97706"
  ];
  executor [
    label="TOOL EXECUTOR\nexposure -> evidence -> risk -> timeout -> dispatch",
    fillcolor="#FEF3C7",
    color="#D97706",
    penwidth=1.8
  ];
  pending [
    label="WRITE-AHEAD CHECKPOINT\nset pending_action before execution",
    fillcolor="#FEF3C7",
    color="#D97706"
  ];
  {rank=same; policies; executor;}
  call -> pending -> executor;
  exposure -> executor [label="same allowed set", color="#D97706", fontcolor="#B45309"];
  policies -> executor [label="authorize"];

  tools [label="BUILT-IN TOOLS\nbrowser / search / PDF / file / task"];
  documents [
    label="DOCUMENT INTELLIGENCE\nprofile -> cloud cascade -> quality gate -> local fallback\ncaption-grounded Figure extraction + vision analysis",
    fillcolor="#F5F3FF",
    color="#7C3AED"
  ];
  {rank=same; tools; documents;}
  executor -> tools [label="authorized dispatch"];
  tools -> documents [label="PDF tools", color="#7C3AED", fontcolor="#7C3AED"];
  documents -> tools [label="structured result", color="#7C3AED", fontcolor="#7C3AED"];

  tool_result [label="ToolResult + policy/risk audit", fillcolor="#ECFDF5", color="#15803D"];
  record [
    label="RECORD STEP\npaired post observation + history/hooks + strategy update",
    fillcolor="#ECFDF5",
    color="#15803D"
  ];
  tools -> tool_result -> record;

  checkpoint [
    label="COMMITTED CHECKPOINT\nclear pending_action + persist next_step and recovery state",
    fillcolor="#ECFDF5",
    color="#15803D"
  ];
  evidence [
    label="AUDIT EVIDENCE\npaired pre/post observations + immutable turn records\nversioned trace + content-addressed blobs",
    fillcolor="#ECFDF5",
    color="#15803D"
  ];
  result [
    label="TERMINAL OUTPUT\nsummary + selected attachment",
    fillcolor="#DCFCE7",
    color="#15803D"
  ];
  {rank=same; checkpoint; evidence; result;}
  record -> checkpoint [label="commit"];
  record -> evidence [label="persist"];
  record -> result [label="done / terminal"];

  verifier [label="Trace / anti-shortcut verification\n(strict evaluation)"];
  evaluator [label="Independent task assertions\n(evaluation runner)"];
  verdict [
    label="OPTIONAL EVALUATION RECORDS\nverification.json + evaluation/task.json",
    shape=oval,
    fillcolor="#DCFCE7",
    color="#15803D",
    penwidth=1.8
  ];
  {rank=same; verifier; evaluator;}
  evidence -> verifier;
  result -> evaluator;
  verifier -> verdict [label="protocol validity", color="#15803D", fontcolor="#15803D"];
  evaluator -> verdict [label="semantic task pass", color="#15803D", fontcolor="#15803D"];
}
