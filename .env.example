# =====================================================================
# web-agent configuration template.  Copy to `.env` and fill in real
# values.  NEVER commit a populated `.env` — it is gitignored.
# =====================================================================

# ── Agent planner LLM (OpenAI-compatible chat completions endpoint) ───
# Provide the FULL chat-completions URL (the planner POSTs to it directly).
# Examples:
#   DeepSeek: https://api.deepseek.com/v1/chat/completions
#   MiniMax: https://api.minimaxi.com/v1/chat/completions
#   ZAI/GLM: https://api.z.ai/api/paas/v4/chat/completions
#   OpenRouter: https://openrouter.ai/api/v1/chat/completions
AGENT_MODEL_NAME=z-ai/glm-5.3-flash
AGENT_MODEL_API_URL=https://openrouter.ai/api/v1/chat/completions
AGENT_MODEL_API_KEY=

# Planner request timeouts (seconds). api_timeout is the per-read HTTP timeout;
# api_hard_timeout is a hard wall-clock cap that bounds trickling/hung responses
# (reasoning models often stream slowly) so one stalled call can't eat the task budget.
AGENT_API_TIMEOUT=60
AGENT_API_HARD_TIMEOUT=300
# Tool-call output remains generous; detailed vision answers are intentionally
# bounded because the planner only needs evidence, not hidden/meta reasoning.
AGENT_PLANNER_MAX_TOKENS=4096
# Prefer provider-native function tools; fall back to provider JSON Schema and
# finally prompt JSON only when the endpoint explicitly rejects a capability.
# Alternatives: native-tools | json-schema | prompt-json
AGENT_PLANNER_OUTPUT_MODE=auto
AGENT_VISION_MAX_TOKENS=2000
AGENT_VISION_BRIEF_MAX_TOKENS=1200
AGENT_VISION_MAX_WORDS=350
# Empty/malformed planner responses are retried within the same logical step.
AGENT_PLANNER_MAX_ATTEMPTS=2
# Keep a long action window, but replay full tool evidence only for the newest
# steps; older steps remain as compact progress summaries in planner context.
AGENT_HISTORY_CONTEXT_LENGTH=10
AGENT_HISTORY_FULL_RESULT_STEPS=2

# Persist a checksummed, non-secret controller checkpoint after each ordinary
# step and before ambiguous actions at <run>/control/checkpoints/<filename>.
# Only the task hash is stored, so resume requires the original --task.
# Strict/search-engine-only runs disable this.
AGENT_CHECKPOINT_ENABLED=true
AGENT_CHECKPOINT_FILENAME=latest.json
# Deterministic replanning from observable failures/no-progress; this does not
# store or reconstruct hidden model chain-of-thought.
AGENT_STRATEGY_ENABLED=true
AGENT_STRATEGY_FAILURE_THRESHOLD=2
AGENT_STRATEGY_NO_PROGRESS_THRESHOLD=3
AGENT_STRATEGY_MAX_SWITCHES=6

# ── Browser and snapshot behavior ───────────────────────────────────
AGENT_BROWSER_HEADLESS=true
# Exact Playwright operation delay. Randomized launch/navigation waits are an
# explicit compatibility opt-in; strict evaluation disables them regardless.
AGENT_BROWSER_SLOW_MO_MS=0
AGENT_BROWSER_HUMANIZE_DELAYS=false
# Keep certificate validation enabled. Set true only for an explicitly trusted
# local test environment with a self-signed certificate.
AGENT_BROWSER_IGNORE_HTTPS_ERRORS=false
# Native Playwright is the auditable default. Enhanced anti-detection behavior
# is an explicit compatibility opt-in and is always disabled by strict eval.
AGENT_STEALTH_MODE=false
# Preserve the browser/system locale and timezone by default. Uncomment only
# when a task explicitly requires a deterministic regional environment.
# AGENT_BROWSER_LOCALE=en-US
# AGENT_BROWSER_TIMEZONE_ID=America/New_York
AGENT_USE_CDP=true
AGENT_MAX_SNAPSHOT_ELEMENTS=50
AGENT_ENABLE_AD_FILTERING=true

# temporary creates and removes a fresh Chromium profile per process. Persistent
# state is an explicit opt-in for trusted interactive sessions only.
AGENT_BROWSER_PROFILE_MODE=temporary
AGENT_BROWSER_PROFILE_DIR=./browser_profile
# On startup, remove only WebAgent-marked temporary profiles older than this
# threshold when their recorded owner PID is no longer running.
AGENT_BROWSER_STALE_PROFILE_MAX_AGE_SECONDS=3600
# upload_file can disclose only files below this root and still requires the
# high-risk action policy to approve the call.
AGENT_BROWSER_UPLOAD_ROOT=./uploads

# Delay between completed actions. Must be a non-negative number of milliseconds.
AGENT_POST_ACTION_WAIT_MS=500

# Legacy switch: true enables challenge detection. Handling is configured below;
# no mode solves or bypasses a CAPTCHA.
AGENT_CAPTCHA_PAUSE=true
# report: log and wait for manual clearance in headed mode; timeout blocks,
#         closes the browser, and ends the task. Headless runs close immediately.
# fail: stop with blocked status (the strict-evaluation default)
# wait_for_human: in headed mode, poll until the user clears it or timeout
AGENT_CAPTCHA_HANDLING=report
AGENT_CAPTCHA_WAIT_TIMEOUT_SECONDS=180
AGENT_CAPTCHA_POLL_INTERVAL_SECONDS=2

# Automated Google searches commonly trigger human verification. Keep disabled
# to use Bing → DuckDuckGo; enable only when Google is explicitly required.
AGENT_ALLOW_GOOGLE_SEARCH=false

# Optional: raises GitHub API rate limits for structured official-repository and
# technical-report discovery. Public searches work without a token at lower limits.
AGENT_GITHUB_TOKEN=
# Independent source cap for official_report_search. A slow arXiv request must
# not hold up an already successful exact-owner GitHub result indefinitely.
AGENT_OFFICIAL_REPORT_SOURCE_TIMEOUT_SECONDS=15

# ── Document parser cascade (cloud OCR: Marker → MinerU → Paddle) ─────
# Soft routing hint: marker | mineru | paddle
AGENT_OCR_PROVIDER=marker

# Datalab Convert (Marker/Chandra) — https://documentation.datalab.to/api-reference/convert-document
AGENT_MARKER_BASE_URL=https://www.datalab.to/api/v1/convert
AGENT_MARKER_API_KEY=

# MinerU Precision Extract — https://mineru.net/doc/docs/index_en/ (API key is a JWT)
AGENT_MINERU_BASE_URL=https://mineru.net/api/v4
AGENT_MINERU_API_KEY=
AGENT_MINERU_MAX_WAIT_SECONDS=600

# PaddleOCR async Jobs API — https://ai.baidu.com/ai-doc/AISTUDIO/fml7mozw5
AGENT_PADDLEOCR_BASE_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
AGENT_PADDLEOCR_API_KEY=
AGENT_PADDLEOCR_MODEL=PP-StructureV3
AGENT_PADDLEOCR_MAX_WAIT_SECONDS=600

# Proxy for cloud OCR calls. Empty = use system HTTP(S)_PROXY / ALL_PROXY.
#   "direct"            → bypass the system proxy (connect directly)
#   socks5://host:port  → pin a specific proxy
# Tip: MinerU's result CDN (cdn-mineru.openxlab.org.cn) may be reachable only
# directly even when mineru.net works through a proxy — use "direct" if so.
AGENT_PARSER_PROXY=

# Conservative exact-Figure-N fast path for text-native vector/raster PDFs.
# Ambiguous caption/graphic matches still use the structured cloud cascade.
AGENT_LOCAL_FIGURE_FAST_PATH=true
AGENT_LOCAL_FIGURE_MIN_CONFIDENCE=0.9
AGENT_LOCAL_FIGURE_RENDER_DPI=144

# ── Output workspace (default: ./outputs) ───────────────────────────
# Without CLI --output, this is a workspace root and each run is allocated at
# runs/<UTC-date>/<model>/<task>-<run-id>/. Explicit --output instead names one
# exact run root. Benchmark executions live separately below studies/; verified
# historical output migrations live below legacy/.
AGENT_OUTPUT_DIR=./outputs

# Content-addressed successful-parse cache is opt-in to prevent cross-run state
# leakage. It may contain text/images derived from the PDF.
AGENT_PERSISTENT_PDF_CACHE=false
AGENT_PDF_CACHE_DIR=~/.cache/webagent/pdf

# Fresh profile, no persistent PDF cache, and isolation fields in
# <run>/trajectory/trace.json (plus verification.json beside it).
AGENT_STRICT_EVAL_MODE=false
# Strict discovery benchmark: ordinary browser-grounded mode already requires
# browser search when a discovery task has neither a user URL nor a loaded page; this additionally
# requires a continuous certified search-only evaluation run.
AGENT_SEARCH_ENGINE_ONLY=false

# Discovery tools exposed to the planner: browser-grounded (default) or hybrid.
# Hybrid explicitly enables arXiv/GitHub direct-source APIs and is not browser-only evidence.
AGENT_DISCOVERY_MODE=browser-grounded

# Externally consequential actions (upload, purchase, publish, delete, etc.).
# deny is the safe non-interactive default; prompt requires a terminal user;
# allow must be an explicit trusted-run opt-in.
AGENT_HIGH_RISK_ACTION_POLICY=deny
